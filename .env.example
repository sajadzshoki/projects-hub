# ── Required ────────────────────────────────────────────────────────────────

# The ONE shared password used to sign in to Project Hub.
PROJECT_HUB_PASSWORD=1111

# MongoDB connection string (local Mongo or MongoDB Atlas).
# Example: mongodb://localhost:27017/project-hub
# Leave empty when using Docker Compose — Compose sets this for the app container.
MONGODB_URI=

# Docker Compose only. Credentials for the MongoDB service in docker-compose.yml.
# Changing these after the first start does not update an existing database volume.
MONGO_USER=projecthub
MONGO_PASSWORD=projecthub

# Host folder mounted into the app container.
# Leave empty for local Compose (uses the project directory).
# In Portainer set APP_DIR=/projects/projects-hub
APP_DIR=

# ── Optional ────────────────────────────────────────────────────────────────

# Secret used to sign session cookies. If omitted, one is derived from
# PROJECT_HUB_PASSWORD. Set a long random string in production.
SESSION_SECRET=

# Set true only when the site is served over HTTPS. Leave empty to follow
# X-Forwarded-Proto (nginx). Plain HTTP, such as http://IP:3000, must not use a Secure cookie.
COOKIE_SECURE=

# Max cover-image upload size in megabytes (default: 5).
MAX_UPLOAD_MB=5

# Directory for local image uploads when MinIO is not configured (default: ./.data/uploads).
LOCAL_UPLOAD_DIR=

# ── Optional MinIO / S3-compatible object storage ───────────────────────────
# When ALL of these are set, cover-image uploads go to object storage instead
# of the local filesystem. Credentials stay server-side — never exposed to the browser.
#
# Compose runs pgsty/silo (MinIO Docker Hub images were removed in 2026).
# Defaults: endpoint http://minio:9000, user/pass minioadmin, bucket projects-hub.
# MINIO_PUBLIC_URL must be non-empty to enable object storage mode.
# Include the bucket name. The app stores {MINIO_PUBLIC_URL}/covers/<file>.
# Example: http://YOUR_SERVER_IP:9000/projects-hub
# Empty MINIO_PUBLIC_URL = local disk uploads under LOCAL_UPLOAD_DIR.

MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=projects-hub
MINIO_PUBLIC_URL=
